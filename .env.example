# Copiá este archivo como .env (en la raíz) para desarrollo local. scripts/dev-api.sh lo carga.
# Usá comillas en valores con espacios o < >.
# Sin RESEND_API_KEY (y con un origen local), los enlaces de acceso se imprimen en la consola de la API en vez de enviarse.
RESEND_API_KEY=
RESEND_FROM='Vitrina <acceso@vitrina.example.com>'
VITRINA_WEB_ORIGIN=http://127.0.0.1:5173
